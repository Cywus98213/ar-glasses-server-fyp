# Copy this file to `config.env` and fill in your values.
#
# Required
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
HF_TOKEN=your_token_here
TRANSCRIPTION_LANGUAGE=zh

# -------------------------
# Speaker threshold tuning
# -------------------------
#
# Simple tuning (recommended)
# - SPEAKER_SIM_THRESHOLD: higher = fewer merges (more splitting), lower = more merges
# - WEARER_SIM_THRESHOLD: higher = stricter wearer match, lower = more lenient wearer match
SPEAKER_SIM_THRESHOLD=0.32
WEARER_SIM_THRESHOLD=0.65
#
# pyannote diarization tuning
DIAR_CLUSTERING_THRESHOLD=0.5
DIAR_MIN_CLUSTER_SIZE=2
DIAR_MIN_DURATION_OFF=0.5
#
# wearer detection (chunk mode)
WEARER_MULTI_VOTE_SIM_THRESHOLD=0.62
WEARER_CHUNK_AVG_THRESHOLD=0.48
WEARER_CHUNK_MEDIAN_THRESHOLD=0.46
WEARER_CHUNK_MAX_THRESHOLD=0.55
WEARER_CHUNK_MATCH_RATIO_THRESHOLD=0.25
WEARER_CHUNK_MATCH_RATIO_MAX_THRESHOLD=0.58
WEARER_CHUNK_COUNT_SIM_THRESHOLD=0.48
WEARER_CHUNK_COUNT_RATIO_THRESHOLD=0.35
WEARER_SINGLE_THRESHOLD_CHUNK=0.65
#
# wearer detection (full-audio diarization mode)
WEARER_FULL_AVG_THRESHOLD=0.52
WEARER_FULL_MEDIAN_THRESHOLD=0.50
WEARER_FULL_MEDIAN_MAX_THRESHOLD=0.58
WEARER_FULL_MATCH_RATIO_THRESHOLD=0.30
WEARER_FULL_MATCH_RATIO_MAX_THRESHOLD=0.62
WEARER_FULL_COUNT_SIM_THRESHOLD=0.50
WEARER_FULL_COUNT_RATIO_THRESHOLD=0.40
WEARER_SINGLE_THRESHOLD_FULL=0.70
#
# speaker tracking / merging (prevents 1 real speaker splitting into many IDs)
SPEAKER_MATCH_THRESHOLD=0.32
SPEAKER_MERGE_BAND_LOW=0.28
SPEAKER_MERGE_BAND_HIGH=0.32
SPEAKER_PROACTIVE_MERGE_THRESHOLD=0.35

